{
  "schema_version": 1,
  "kind": "component",
  "model": "ticking",
  "name": "fullcomp",
  "package": "github.com/sarchlab/akita/v5/inspect/testdata/fixtures/fullcomp",
  "module": "github.com/sarchlab/akita/v5",
  "spec": [
    {
      "name": "Freq",
      "json_name": "freq",
      "type": "github.com/sarchlab/akita/v5/sim/timing.Freq",
      "doc": "Freq is the clock frequency.",
      "default": 1000000000,
      "unit": "Hz"
    },
    {
      "name": "NumLanes",
      "json_name": "num_lanes",
      "type": "int",
      "doc": "NumLanes is the number of parallel lanes.",
      "default": 4,
      "min": 1,
      "max": 64
    },
    {
      "name": "NumOut",
      "json_name": "num_out",
      "type": "int",
      "doc": "NumOut is the number of Out ports the system builder wires.",
      "default": 0
    },
    {
      "name": "Mode",
      "json_name": "mode",
      "type": "Mode",
      "doc": "Mode selects how precisely the component is modeled.",
      "default": "fast",
      "choices": [
        "accurate",
        "fast"
      ]
    },
    {
      "name": "Hidden",
      "type": "int",
      "default": 0
    }
  ],
  "resources": [
    {
      "name": "Mapper",
      "type": "github.com/sarchlab/akita/v5/mem.AddressToPortMapper",
      "doc": "Mapper locates the remote port that serves a given address."
    }
  ],
  "ports": [
    {
      "name": "Top",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memprotocol",
          "role": "responder"
        }
      ]
    },
    {
      "name": "Ctrl",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memprotocol",
          "role": "responder"
        },
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memcontrolprotocol",
          "role": "responder"
        }
      ]
    },
    {
      "name": "Out",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memprotocol",
          "role": "requester"
        }
      ],
      "group": true
    }
  ],
  "middlewares": [
    {
      "name": "Control",
      "type": "*controlMW",
      "doc": "Control handles control commands."
    },
    {
      "name": "Serve",
      "type": "*serveMW",
      "doc": "Serve forwards requests from Top to Out."
    }
  ]
}
