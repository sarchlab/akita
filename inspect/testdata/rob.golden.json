{
  "schema_version": 1,
  "kind": "component",
  "model": "ticking",
  "name": "rob",
  "package": "github.com/sarchlab/akita/v5/mem/rob",
  "module": "github.com/sarchlab/akita/v5",
  "spec": [
    {
      "name": "Freq",
      "json_name": "freq",
      "type": "github.com/sarchlab/akita/v5/simulation/timing.Freq",
      "default": 1000000000,
      "unit": "Hz"
    },
    {
      "name": "BufferSize",
      "json_name": "buffer_size",
      "type": "int",
      "default": 128
    },
    {
      "name": "NumReqPerCycle",
      "json_name": "num_req_per_cycle",
      "type": "int",
      "default": 4
    },
    {
      "name": "BottomUnit",
      "json_name": "bottom_unit",
      "type": "github.com/sarchlab/akita/v5/simulation/messaging.RemotePort",
      "doc": "BottomUnit is the remote port of the unit that the reorder buffer\nforwards requests to. The reorder buffer rewrites the Dst of every\nshadow request to this value.",
      "default": ""
    }
  ],
  "ports": [
    {
      "name": "Top",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memprotocol",
          "role": "responder"
        }
      ]
    },
    {
      "name": "Bottom",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memprotocol",
          "role": "requester"
        }
      ]
    },
    {
      "name": "Control",
      "roles": [
        {
          "protocol": "github.com/sarchlab/akita/v5/mem/memcontrolprotocol",
          "role": "responder"
        }
      ]
    }
  ],
  "middlewares": [
    {
      "name": "Pipeline",
      "type": "*middleware",
      "doc": "Pipeline handles control commands, forwards requests, and releases\nresponses in order."
    }
  ]
}
